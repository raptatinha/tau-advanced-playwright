{
  "name": "tau-advanced-playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test-ui": "npm run test-ui-c && npm run test-ui-auth-admin && npm run test-ui-auth-user && npm run test-ui-auth",
    "test-ui-c": "npx playwright test tests/ui/specs/ --project=chromium",
    "test-ui-h": "npx playwright test tests/ui/specs/ --project=chromium --headed",
    "test-ui-auth-admin": "npx playwright test profile-stored-auth-multi-role-admin.spec.ts --project=chromium-auth -c playwright-auth.config.ts",
    "test-ui-auth-user": "npx playwright test profile-stored-auth-multi-role-user.spec.ts --project=chromium-auth -c playwright-auth.config.ts",
    "test-ui-auth": "npx playwright test profile-stored-auth-multi-role-example.spec.ts --project=chromium-auth -c playwright-auth.config.ts",
    "test-vrt": "npx playwright test visual-regression.spec.ts --project=chromium",
    "test-ui-setup": "npx playwright test tests/ui/specs/ --project=chromium -c playwright-setup-projects.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@applitools/eyes-playwright": "1.53.1",
    "@playwright/test": "1.65.1",
    "dotenv": "18.0.10"
  }
}
